# 🌍 Frontend URL (CORS ke liye)
FRONTEND_URL=http://localhost:5173

# 🌐 Backend API URL
# VITE_API_URL=https://smartudharapi.furfoori.com
VITE_API_URL=http://localhost:5000

# 📦 Environment
NODE_ENV=development

